{
  "name": "@tissuumaps/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "canvas": "^3.2.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "fmt": "prettier --write --ignore-unknown .",
    "fmt:check": "prettier --check --ignore-unknown .",
    "test": "vitest run --passWithNoTests --coverage",
    "dev": "pnpm run --filter tissuumaps dev",
    "docs": "pnpm run --filter docs start",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:apps": "pnpm run -r --filter \"./apps/**\" build",
    "build:packages": "pnpm run -r --filter \"./packages/**\" build",
    "clean": "rm -rf node_modules && pnpm run -r clean"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
