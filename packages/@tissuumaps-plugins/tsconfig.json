{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./build", // output for tsc -b (declaration files), separate from vite output (./dist)
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "references": [{ "path": "../@tissuumaps-core" }],
  "include": ["./src"],
  "exclude": ["./src/**/*.test.js", "./src/**/*.test.ts"]
}
